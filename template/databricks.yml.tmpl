bundle:
  name: {{.project_name}}

include:
{{- if eq .include_job "yes" }}
  - resources/jobs/*.yml
{{- end }}
{{- if eq .include_dashboard "yes" }}
  - resources/dashboards/*.yml
  - resources/dashboards/*.json
{{- end }}

variables:
  catalog_name:
    description: Unity Catalog name
  schema_name:
    description: Schema name within the catalog
  table_name:
    description: Target table name
  department:
    description: Department tag for resources
  environment:
    description: Environment tag (dev, staging, prod)
  team:
    description: Team tag for resources
  warehouse_id:
    description: SQL Warehouse ID for running SQL tasks

targets:
  dev:
    mode: development
    default: true
    workspace:
      root_path: ~/.bundle/${bundle.name}
      host: {{workspace_host}}
    variables:
      catalog_name: dev_reporting
      schema_name: bakehouse_sales
      table_name: gold_sales_monitoring
      department: sales
      environment: dev
      team: Sales Analytics
      warehouse_id: 86e2d617c669fbc1
  prod: # Update this section as you need.
    mode: production
    workspace:
      host: {{workspace_host}}
      root_path: /Shared/.bundle/prod/${bundle.name}
    run_as:
      user_name: {{user_name}}
